# Copy to .env and fill in. Never commit .env.

# --- Runtime ---
# Allowed: paper | testnet. Anything else refuses to start.
TRADING_MODE=testnet
LOG_LEVEL=INFO

# --- Postgres (Deskmind's own container; NOT the 5432 server) ---
POSTGRES_USER=deskmind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=deskmind
POSTGRES_HOST=127.0.0.1
POSTGRES_HOST_PORT=5435

# --- Redis (Deskmind's own container) ---
REDIS_HOST=127.0.0.1
REDIS_HOST_PORT=6380

# --- Binance USDT-M Futures (TESTNET keys, from testnet.binancefuture.com) ---
# Keys are only ever sent to the testnet host below; mainnet URLs are refused at startup.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_FUTURES_BASE_URL=https://testnet.binancefuture.com

# --- Binance MAINNET read-only key (optional; your real account, READ ONLY) ---
# Create it with ONLY "Enable Reading" ticked. The client refuses keys with trading, withdraw,
# transfer or margin permission, sends GET requests to an allowlist only, and never trades.
# Used for: account sync (fees/brackets), balance on the Account page, trade-history import.
BINANCE_MAINNET_READONLY_API_KEY=
BINANCE_MAINNET_READONLY_API_SECRET=

# --- Historical / live market data (public endpoints, no key) ---
DATA_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
BINANCE_MARKET_DATA_URL=https://fapi.binance.com

# --- LLM for the Head agent, via OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
